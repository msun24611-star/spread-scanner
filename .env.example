# 复制本文件为 .env 并填入你自己的老虎凭证(.env 已被 .gitignore 排除,不会上传)。
# Windows 下也可直接用「系统环境变量」或在启动前 set / $env: 设置。

# 老虎 Open API 账号信息
TIGER_ID=你的_tiger_id
TIGER_ACCOUNT=你的_账户号

# 私钥文件的本地绝对路径(去老虎开发者后台生成 RSA 私钥)
TIGER_PRIVATE_KEY_PATH=C:\path\to\your\private_key.pem

# 外网访问密码(不设则读 access_password.txt,再不设默认 tiger2026)
SCANNER_PASSWORD=改成一个强密码
